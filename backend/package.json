{
  "name": "zoiko-pay-console-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Zoiko Pay Admin Console BFF: Keycloak login, server-side authorization and audit for the console. No payment or ledger logic.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node --env-file-if-exists=.env scripts/e2e-auth.mjs",
    "setup:sso": "node scripts/configure-local-sso.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "openid-client": "6.8.9",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
