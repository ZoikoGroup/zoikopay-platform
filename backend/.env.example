# Zoiko Pay Console backend. Copy to .env for local development.
# Local development values only: never reuse them in a shared environment.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# The frontend's address. Only requests from this origin may sign in or make changes.
CONSOLE_PUBLIC_ORIGIN=http://localhost:5173

# Keycloak realm "zoikopay" (stand-in for Zoiko iD).
OIDC_ISSUER=http://localhost:8180/realms/zoikopay
OIDC_CLIENT_ID=zoikopay-console
OIDC_CLIENT_SECRET=local-dev-only-console-secret

# Service client used only to create accounts and change passwords.
ACCOUNT_ADMIN_CLIENT_ID=zoikopay-console-admin
ACCOUNT_ADMIN_CLIENT_SECRET=local-dev-only-account-admin-secret

# Signs the session cookie. Generate your own: openssl rand -hex 32
SESSION_SECRET=local-dev-only-session-secret-change-me-0001

# Go deployables probed by System Health (name=base URL, comma separated).
GO_SERVICES=gateway=http://localhost:8080,execution=http://localhost:8081,finance=http://localhost:8082,governance=http://localhost:8083,outbox-relay=http://localhost:8084,mockpsp=http://localhost:8090

# Development fixtures stand in for Go business APIs that do not exist yet.
# They are only ever served for the TEST environment and are always labelled.
DATA_SOURCE=fixtures
